{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "macOSPrivateApi": false,
    "windows": [
      {
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "windowEffects": null
      }
    ]
  },
  "bundle": {
    "targets": ["app"],
    "createUpdaterArtifacts": false,
    "macOS": {
      "signingIdentity": "Apple Distribution: <Team>",
      "provisioningProfile": "EsploroMAS.provisionprofile",
      "entitlements": "Esploro-MAS.entitlements"
    }
  },
  "plugins": {
    "updater": {
      "active": false
    }
  }
}
